OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini
PRISMA_CHAT_PROVIDER=auto

# hErmes runtime proxy (M0/M1)
HERMES_API_BASE_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent
HERMES_DEFAULT_CONVERSATION=marketing-demo
HERMES_DROPLET_HOST=shared-droplet
HERMES_IMAGE_REF=prisma/hermes:stable

# External memory (Phase 3): Supermemory is the locked provider.
# Owner: Prisma platform (platform-wide shared account). Agents receive a
# namespace `prisma:<workspaceId>:<agentId>` via the resolved memory config;
# Hermes is expected to dereference `env:SUPERMEMORY_API_KEY` on its own.
# Leave unset to fall back to a workspace vault integration with slug
# `supermemory`, or emit `{ provider: "none" }`.
SUPERMEMORY_API_KEY=

# Hermes Messaging Gateway (Phase 3)
# Telegram/WhatsApp/Email are resolved per-workspace from the vault,
# but the gateway itself may need a shared bot username or webhook URL.
HERMES_GATEWAY_WEBHOOK_BASE_URL=
# Internal Prisma MCP session JWT signing key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, Prisma falls back to HERMES_API_KEY (recommended: set explicitly).
PRISMA_MCP_JWT_SECRET=
# Short-lived token TTL in seconds (default 900; min 60, max 86400).
PRISMA_MCP_JWT_TTL_SECONDS=900
PRISMA_INTAKE_SUBDOMAIN_PREFIX=intake.
PRISMA_APP_SUBDOMAIN_PREFIX=app.
PRISMA_APP_DEFAULT_PATH=/workspaces

# Intake + storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=intake-assets
# Comma-separated list of operator emails with platform-admin access.
# REQUIRED in production. Must not be "admin@example.com" or other defaults
# (see SECURITY_NOTE.md). Leave unset in local dev to disable admin access.
PRISMA_PLATFORM_ADMIN_EMAILS=
PRISMA_ADMIN_SIGNUP_SECRET=

# Disable local JSON fallback after M1 hardening
PRISMA_DISABLE_LOCAL_FALLBACK=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Public site url used by checkout fallback redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional internal notifications webhook (Slack/Discord/custom)
OPS_WEBHOOK_URL=

# Per-workspace integrations vault encryption key (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production. Dev falls back to a derived key if unset.
PRISMA_SECRETS_KEY=

# Image studio providers (Part 2)
# Primary: image generation + img2img via OpenRouter. Reuses OPENROUTER_API_KEY above.
# Default model is google/gemini-2.5-flash-image-preview ("nano-banana"). Override with:
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
# Optional fallback: hit Google GenAI directly if OPENROUTER_API_KEY is unset.
GOOGLE_GENAI_API_KEY=
GOOGLE_GENAI_IMAGE_MODEL=gemini-2.5-flash-image-preview
# SerpAPI for web image search (Google Images).
SERPAPI_KEY=
# Set to "1" to log every OpenRouter image request (model, ref count, prompt preview)
# and the response shape when parsing fails. Useful for reconciling invoice rows
# with prompts and diagnosing "credits burned but no image returned" cases.
PRISMA_IMAGE_DEBUG=

# Cron authentication
# Shared secret for /api/cron/* routes. Vercel's platform cron requests
# set `x-vercel-cron: 1` and are accepted without the header. Leave empty
# in local dev to allow manual GETs.
CRON_SECRET=

# ManyChat bridge (inbound webhook + outbound send)
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=
MANYCHAT_AUTO_REPLY=Gracias por tu mensaje. Un asesor te atenderá en breve.

# OpenClaw multi-agent gateway (optional; Hermes is default runtime)
OPENCLAW_HOME=~/.openclaw
OPENCLAW_AGENT_URL=http://localhost:18789

# Telegram bots (3 bots via @BotFather, one per agent)
TELEGRAM_BOT_TOKEN_OPERATOR=
TELEGRAM_BOT_TOKEN_LEADS=
TELEGRAM_BOT_TOKEN_QUALIFIED=
OPERATOR_TELEGRAM_USER_ID=

# Browser-Use Cloud (managed)
BROWSER_USE_API_BASE_URL=https://api.browser-use.com
BROWSER_USE_API_KEY=
