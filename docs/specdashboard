## 6. Full Database Schema (Migrations)

### 6.1 `20260420_000003_intake_submissions.sql`

```sql
CREATE TABLE public.intake_submissions (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  full_name TEXT NOT NULL,
  business_name TEXT NOT NULL,
  website_url TEXT,
  business_location TEXT NOT NULL,
  reason TEXT NOT NULL,
  brand_assets TEXT[],
  email TEXT NOT NULL,
  lead_score INTEGER DEFAULT 0,
  status TEXT DEFAULT 'new' CHECK (status IN ('new','contacted','workspace_created','rejected')),
  admin_notes TEXT,
  referral_source TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_intake_submissions_status ON public.intake_submissions(status, created_at DESC);
CREATE INDEX idx_intake_submissions_email ON public.intake_submissions(email);

ALTER TABLE public.workspaces
  ADD COLUMN IF NOT EXISTS intake_submission_id UUID REFERENCES public.intake_submissions(id) ON DELETE SET NULL;
```

### 6.2 `20260420_000004_credits_and_billing.sql`

```sql
-- Credit allocations per workspace
CREATE TABLE public.workspace_credit_allocations (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  workspace_id UUID NOT NULL REFERENCES public.workspaces(id) ON DELETE CASCADE,
  credits_included INTEGER NOT NULL DEFAULT 50000,
  credits_per_agent INTEGER NOT NULL DEFAULT 50000,
  reset_day INTEGER DEFAULT 1,
  overage_rate NUMERIC(10,6) DEFAULT 0.000100,
  stripe_meter_id TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);

-- Usage events
CREATE TABLE public.credit_usage_events (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  workspace_id UUID NOT NULL REFERENCES public.workspaces(id) ON DELETE CASCADE,
  agent_id UUID REFERENCES public.workspace_agents(id) ON DELETE SET NULL,
  user_id UUID REFERENCES auth.users(id) ON DELETE SET NULL,
  model TEXT NOT NULL,
  prompt_tokens INTEGER NOT NULL DEFAULT 0,
  completion_tokens INTEGER NOT NULL DEFAULT 0,
  total_tokens INTEGER NOT NULL DEFAULT 0,
  cost_usd NUMERIC(10,6) NOT NULL DEFAULT 0,
  event_type TEXT DEFAULT 'agent_call',
  metadata JSONB DEFAULT '{}'::jsonb,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

CREATE INDEX idx_credit_usage_workspace_created ON public.credit_usage_events(workspace_id, created_at DESC);
CREATE INDEX idx_credit_usage_agent ON public.credit_usage_events(agent_id, created_at DESC);
CREATE INDEX idx_credit_usage_user ON public.credit_usage_events(user_id, created_at DESC);

-- Monthly usage summaries
CREATE TABLE public.workspace_usage_summaries (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  workspace_id UUID NOT NULL REFERENCES public.workspaces(id) ON DELETE CASCADE,
  billing_period_start DATE NOT NULL,
  billing_period_end DATE NOT NULL,
  total_tokens BIGINT DEFAULT 0,
  total_cost_usd NUMERIC(10,4) DEFAULT 0,
  included_credits INTEGER DEFAULT 0,
  overage_tokens BIGINT DEFAULT 0,
  overage_cost_usd NUMERIC(10,4) DEFAULT 0,
  stripe_usage_record_id TEXT,
  finalized BOOLEAN DEFAULT FALSE,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  UNIQUE(workspace_id, billing_period_start)
);

-- Stripe billing config
CREATE TABLE public.workspace_billing (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  workspace_id UUID NOT NULL UNIQUE REFERENCES public.workspaces(id) ON DELETE CASCADE,
  stripe_customer_id TEXT,
  stripe_subscription_id TEXT,
  stripe_metered_subscription_item_id TEXT,
  agent_count INTEGER DEFAULT 1,
  plan_base_price_cents INTEGER DEFAULT 25000,
  hosting_price_cents INTEGER DEFAULT 0,
  status TEXT DEFAULT 'active' CHECK (status IN ('active','past_due','cancelled','trialing')),
  trial_ends_at TIMESTAMPTZ,
  current_period_start TIMESTAMPTZ,
  current_period_end TIMESTAMPTZ,
  created_at TIMESTAMPTZ DEFAULT NOW(),
  updated_at TIMESTAMPTZ DEFAULT NOW()
);
```

