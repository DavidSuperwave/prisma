{
  "name": "hermes-whatsapp-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "Baileys-based WhatsApp pairing sidecar for the Prisma/Hermes stack. Exposes /v1/channels/whatsapp/* endpoints consumed by the Prisma dashboard.",
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "bin": {
    "hermes-whatsapp-sidecar": "dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "6.7.9",
    "express": "4.21.1",
    "pino": "9.5.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "20.12.12",
    "@types/qrcode": "1.5.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=18.17"
  }
}
