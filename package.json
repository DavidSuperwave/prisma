    "test:inventory-vercel-link": "node scripts/e2e_inventory_vercel_link.mjs",
    "ci:verify": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.102.1",
    "lucide-react": "^0.577.0",
    "next": "^16.1.6",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "stripe": "^22.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.4.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.1.6",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.98"
  }
